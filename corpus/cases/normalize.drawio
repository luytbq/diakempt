<mxfile host="Electron">
  <diagram id="n" name="Normalize">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="g" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="40" y="40" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="box" value="" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="g">
          <mxGeometry width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="boxtext" value="Receive order" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="g">
          <mxGeometry x="20" y="15" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="check" value="Check stock" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ship" value="Ship" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="refund" value="Refund" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="300" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="boxtext" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="check" target="ship">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="refund" target="w2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="in stock" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="114" y="250" width="60" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
